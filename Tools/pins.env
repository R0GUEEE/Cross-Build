# Backend pins
#
# Every input the app's runtime layers are built from, in one file, with a
# content hash. A build reads this file; it does not carry its own copies of these
# values. That is the whole point: the Alpine root, the engine commit and the Python
# support package used to be spelled out in three different workflow steps, and the
# guest's package list in three more.
#
# Format: `KEY=value`, `#` starts a comment, blank lines ignored. Values are read by
# Tools/build-engine.sh, Tools/build-rootfs.sh and Tools/build-python.sh.

# ---------------------------------------------------------------- engine

# rcarmo/ios-linuxkit — the Linux compatibility layer. Pinned by commit, and also
# checked out as the git submodule at Vendor/linuxkit; the build asserts they agree.
ENGINE_REPO=https://github.com/rcarmo/ios-linuxkit.git
ENGINE_COMMIT=c1a4064e84f1a957280a62f77d107162032dc908
ENGINE_VERSION=2.4.1
# Interpreted, no code emission. AOT needs per-ABI, per-app and per-guest recordings
# that do not exist for this guest; see docs/AOT.md.
ENGINE_JIT=false
ENGINE_JIT_EMIT=false

# ---------------------------------------------------------------- guest root

ALPINE_VERSION=3.24.2
ALPINE_ROOTFS_URL=https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/aarch64/alpine-minirootfs-3.24.2-aarch64.tar.gz
ALPINE_ROOTFS_SHA256=9bf70a7f18ea44094cbb5f70c58f9af129c8214745743db0e68e5502cc2ce773

# Packages installed into the guest. Everything a build action can reach for.
# Swift, Rust, Go, Zig, the JDK and Kotlin are absent on purpose: each is 170-200 MB
# installed, and Swift/Kotlin have no musl/aarch64 build at all.
GUEST_PACKAGES="bash coreutils findutils grep sed gawk git tar gzip xz ca-certificates make gcc g++ musl-dev binutils dpkg fakeroot cmake ninja-build meson python3 py3-pip py3-setuptools py3-wheel py3-installer py3-packaging py3-pyproject-hooks pkgconf autoconf automake libtool nodejs npm zlib-dev openssl-dev libffi-dev ncurses-dev readline-dev sqlite-dev bzip2-dev linux-headers"

# Executables that must exist after provisioning.
GUEST_REQUIRED_TOOLS="make cc gcc c++ g++ dpkg-deb ar ld cmake ninja meson python3 pip3 node npm"

# Tools that must NOT be in the image. Absence is asserted, not assumed.
GUEST_FORBIDDEN_TOOLS="clang clang++ ld.lld cargo rustc go zig swift swiftc javac kotlinc"

# Paths removed after provisioning, relative to the guest root. Each is measured and
# printed. libgcc.a is deliberately NOT here: gcc passes -lgcc on dynamic links, and
# removing it fails every link.
GUEST_TRIM_PATHS="/usr/share/doc /usr/share/man /usr/share/info /usr/share/locale /usr/share/gtk-doc /usr/share/gettext /usr/share/terminfo /usr/lib/gcc/*/include-fixed /usr/bin/gprof /usr/bin/gcov /usr/bin/gcov-dump /usr/bin/gcov-tool /usr/bin/ld.gold /usr/bin/dwp /usr/libexec/gcc/*/*/lto1 /usr/bin/lto-dump /usr/lib/libc.a /usr/lib/libstdc++.a /usr/lib/gcc/*/*/libstdc++.a /usr/share/cmake/Help /usr/share/cmake/man /var/cache/apk /usr/share/zoneinfo"

# ---------------------------------------------------------------- embedded CPython

PYTHON_VERSION=3.13
PYTHON_SUPPORT_TAG=3.13-b15
PYTHON_SUPPORT_URL=https://github.com/beeware/Python-Apple-support/releases/download/3.13-b15/Python-3.13-iOS-support.b15.tar.gz
PYTHON_SUPPORT_SHA256=80175765a31babe43b0910395cf86ba4e8412adf1902b069d55b74d523ecc5d1

# Removed from the standard library: CPython's test suite alone is 35 MB of 61 MB.
PYTHON_STDLIB_TRIM="test ensurepip idlelib tkinter lib2to3 turtledemo pydoc_data turtle.py"

# Extension modules that must survive staging, or Python starts and then fails the
# first `import sqlite3`.
PYTHON_REQUIRED_EXTENSIONS="_sqlite3 _ssl _hashlib zlib _decimal"

# ---------------------------------------------------------------- app dependency

# Resolved once and committed as Package.resolved; the Xcode build refuses to
# re-resolve. Bump deliberately, not implicitly.
ZIPFOUNDATION_MIN_VERSION=0.9.19
